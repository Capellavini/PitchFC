# Copy to .env (never commit). Read lazily — see src/config.js.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only. Never in the Vite client.
APP_URL=https://pitch-fc.com

# SAFETY: dry-run by default. Nothing is sent (or claimed) until this is "true".
BOT_AUTOSEND=false

# Ban-risk guards
BOT_MAX_PER_DAY=4                      # proactive messages per group per day (cancellations exempt)
BOT_QUIET_START=23                     # Lisbon hour: no proactive sends from here...
BOT_QUIET_END=8                        # ...until here
BOT_POLL_SECONDS=30

# @Pitch answers (optional — without a key the bot only posts events)
ANTHROPIC_API_KEY=
ASK_MODEL=claude-haiku-4-5

# Optional: link with a pairing code instead of a QR (chip number, digits only, with country code)
WA_PAIR_PHONE=
