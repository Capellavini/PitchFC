{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"]
  },
  "include": ["server", "src", "scripts", "tests", "vite.config.ts"]
}
